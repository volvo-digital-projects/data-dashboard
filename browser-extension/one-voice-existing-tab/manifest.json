{
  "manifest_version": 3,
  "name": "Volvo ONE VOICE Existing Tab Sync",
  "version": "1.3.0",
  "description": "Automatically opens ONE VOICE at 10:00 KST, captures the scores, and recovers missed weekday syncs.",
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://volvo.medallia.eu/*",
    "https://volvo-dsc-pc-test-2026.kongboojang.chatgpt.site/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://volvo.medallia.eu/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ONE VOICE existing-tab sync"
  }
}
